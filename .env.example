# Supabase public browser configuration (Vite reads VITE_ variables)
VITE_SUPABASE_URL=https://ilsedfirfdrbipsvxopu.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_or_publishable_key

# Optional explicit API configuration. The API also falls back to VITE_SUPABASE_URL / VITE_SUPABASE_KEY.
SUPABASE_URL=https://ilsedfirfdrbipsvxopu.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Server-only Vercel API configuration. Never prefix these with VITE_ or expose them to the browser.
QZ_SIGNING_PRIVATE_KEY=replace_with_matching_qz_private_key_pem_use_escaped_newlines
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:serviotech.sa@gmail.com
NOTIFY_WEBHOOK_SECRET=replace_with_random_webhook_secret
